  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "build": "vite build && if [ -d .output/server ]; then cp instrument.server.mjs .output/server; fi",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps",
    "test:e2e:ui": "playwright test --ui",
    "evals": "dotenv -e .env.local -- tsx evals/run.ts",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "lint": "oxfmt src convex evals tests && oxlint src convex evals tests",
    "lint:check": "oxfmt --check src convex evals tests && oxlint src convex evals tests",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts"
  },
