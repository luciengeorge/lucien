# Required BEFORE `pnpm install`: private @hugeicons-pro registry auth token.
# Without it, `pnpm install` fails on the private registry (see .npmrc).
# Obtain from the hugeicons.com account; CI reads it from the HUGEICONS_TOKEN GitHub Actions secret.
HUGEICONS_TOKEN=

# --- Required (app throws / misbehaves without these) ---
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
BETTER_AUTH_SECRET=
TOAST_SECRET=
OPENAI_API_KEY=
SITE_URL=http://localhost:3000

# --- Optional (features degrade / no-op if unset) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Dev / e2e only (never set in production) ---
AUTH_ALLOWED_EMAILS=
E2E_TEST_MODE=
